from abc import ABC, abstractmethod


class Product(ABC):
    def __init__(self, name, price):
        self.name = name
        self.__price = price

    # Getter
    def get_price(self):
        return self.__price

    # Setter
    def set_price(self, price):
        if price > 0:
            self.__price = price

    @abstractmethod
    def category(self):
        pass

    # Overloading using default argument
    def buy(self, quantity=1):
        return self.__price * quantity


class Electronics(Product):
    def category(self):
        print("Category: Electronics")

    # Overriding
    def buy(self, quantity=1):
        price = super().buy(quantity)
        return price - 500


class Clothing(Product):
    def category(self):
        print("Category: Clothing")

    # Overriding
    def buy(self, quantity=1):
        price = super().buy(quantity)
        return price - 200


mobile = Electronics("Mobile", 20000)
shirt = Clothing("Shirt", 1000)

mobile.category()
print("Mobile Price:", mobile.get_price())
print("Final Price:", mobile.buy(2))

print()

shirt.category()
print("Shirt Price:", shirt.get_price())
print("Final Price:", shirt.buy(3))

shirt.set_price(1200)
print("Updated Price:", shirt.get_price())
